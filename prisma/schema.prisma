// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  GUARD
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String
  name          String?
  emailVerified DateTime? @db.Timestamp()
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  services                Service[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  requests                Request[]
  guardProfile            GuardProfile?
  requestEvents           RequestEvent[]
  notifications           Notification[]
  reviews                 Review[]
}

model Service {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  trackingCode String @unique
  type         String
  status       String @default("PENDING")

  pickupAddress   String?
  deliveryAddress String?
  notes           String?

  etaFrom DateTime?
  etaTo   DateTime?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("service_requests")
}

model EmailVerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  token  String @unique
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum RequestType {
  ESCORT
  PERSONAL_SECURITY
  DELIVERY
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Request {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  type          RequestType
  status        RequestStatus  @default(PENDING)
  userId        String         @db.ObjectId
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes         String?
  details       Json
  trackingCode  String         @unique
  guardId       String?        @db.ObjectId
  guard         GuardProfile?  @relation(fields: [guardId], references: [id], onDelete: Cascade)
  etaFrom       DateTime?
  etaTo         DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requestEvents RequestEvent[]
  trackingPings TrackingPing[]
  reviews       Review[]

  @@index([userId])
  @@index([status])
}

model GuardProfile {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  userId  String  @unique @db.ObjectId
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId String? @unique
  phone   String?
  active  Boolean @default(true)

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  requests     Request[]
  availability GuardAvailability[]
  reviews      Review[]

  @@index([active])
}

enum RequestEventType {
  REQUEST_CREATED
  STATUS_CHANGED
  GUARD_ASSIGNED
  ETA_UPDATED
  NOTE_ADDED
  TRACKING_ACTIVATED
  JOB_STARTED
  JOB_COMPLETED
  REQUEST_CANCELLED
}

model RequestEvent {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  requestId String           @db.ObjectId
  request   Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      RequestEventType
  message   String?
  meta      Json?

  actorId    String?  @db.ObjectId
  actorRole  Role?
  actorName  String?
  actorEmail String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([requestId])
  @@index([type])
  @@map("request_events")
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model GuardAvailability {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  guardId   String       @db.ObjectId
  guard     GuardProfile @relation(fields: [guardId], references: [id], onDelete: Cascade)
  day       DayOfWeek
  startMin  Int
  endMin    Int
  timezone  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([guardId])
  @@index([day])
  @@index([guardId, day])
}

enum NotificationType {
  REQUEST_CREATED
  STATUS_CHANGED
  GUARD_ASSIGNED
  ETA_UPDATED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
  SYSTEM
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  message   String
  title     String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt])
  @@index([createdAt])
  @@index([userId])
}

enum TrackingSource {
  GUARD
  ADMIN
  SYSTEM
}

enum TrackingKind {
  LOCATION
  CHECKPOINT
  STATUS
}

model TrackingPing {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  requestId String         @db.ObjectId
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  guardId   String?        @db.ObjectId
  source    TrackingSource @default(GUARD)
  kind      TrackingKind   @default(LOCATION)
  lat       Float?
  lng       Float?
  accuracyM Int?
  speedMps  Float?
  heading   Float?
  meta      Json?
  label     String?
  note      String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([guardId, createdAt])
  @@index([kind])
}

model Review {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  requestId String        @db.ObjectId
  request   Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardId   String?       @db.ObjectId
  guard     GuardProfile? @relation(fields: [guardId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdAt])
  @@index([userId])
  @@index([guardId])
}
